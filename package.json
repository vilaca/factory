{
  "name": "factory",
  "version": "0.1.0",
  "description": "Interactive terminal coding agent with tool use, plan mode, and pluggable LLM providers (local and cloud).",
  "main": "dist/index.js",
  "bin": {
    "factory": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:test": "tsc -p tsconfig.test.json",
    "clean": "rm -rf dist dist-test *.tsbuildinfo",
    "knip": "knip",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:e2e": "tsc && tsc -p tsconfig.test.json && node --test dist-test/test/e2e.test.js",
    "test:only": "node --test dist-test/test/e2e.test.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@huggingface/inference": "^4.13.15",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.4.1",
    "google-auth-library": "^10.6.2",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ollama": "^0.5.12",
    "react": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "knip": "^6.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
